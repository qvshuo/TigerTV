TIGERTV_LISTEN=0.0.0.0
TIGERTV_PORT=18811
# Optional exact origin for a cross-origin metadata API client.
TIGERTV_WEB_ORIGIN=
# Optional comma-separated keys from api_site. Blank uses all eligible sources.
TIGERTV_SITES=

# Existing Docker network for compose.network.yaml.
TIGERTV_PROXY_NETWORK=proxy
